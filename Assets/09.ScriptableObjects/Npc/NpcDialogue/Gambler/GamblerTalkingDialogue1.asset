  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: GamblerTalkingDialogue1
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: GamblerTalkingDialogue1
  Lines:
  - Text: "\uD5E4\uD5F7~ \uD639\uC2DC \uC6B4 \uC88B\uB2E4\uB294 \uB9D0, \uB9CE\uC774
      \uB4E4\uC5B4\uBCF4\uC168\uC8E0?"
    NextDialogue: {fileID: 0}
  - Text: "\uC624\uB298 \uD589\uC6B4\uC758 \uC5EC\uC2E0\uC774 \uD3B8\uC744 \uB4E4\uC5B4\uC904
      \uC0AC\uB78C\uC740\u2026 \uB2F9\uC5F0\uD788 \uB2F9\uC2E0 \uC544\uB2D0\uAE4C\uC694~?"
    NextDialogue: {fileID: 0}
  - Text: "\uD55C \uBC88 \uC9C1\uAC10\uC744 \uBBFF\uACE0 \uCC0D\uC5B4\uBCF4\uB294
      \uAC70 \uC5B4\uB54C\uC694? \uC81C\uAC00 \uD2B9\uBCC4\uD788 \uD589\uC6B4 \uC880
      \uC5B9\uC5B4\uB4DC\uB9B4\uAC8C\uC694!!"
    NextDialogue: {fileID: 0}
