  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: GamblerCompleteDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: GamblerCompleteDialogue
  Lines:
  - Text: "\uACE1\uB8E1 \uB808\uC774\uC2F1\uC740 \uADC0\uC5EC\uC6B4 \uACE1\uB8E1
      \uCE5C\uAD6C\uB4E4\uC774 \uB2EC\uB9AC\uAE30\uB97C \uD558\uB294 \uACBD\uC8FC\uB78D\uB2C8\uB2E4!"
    NextDialogue: {fileID: 0}
  - Text: "\uBA3C\uC800, \uC774\uAE38 \uAC83 \uAC19\uC740 \uACE1\uB8E1\uC5D0\uAC8C
      \uACE8\uB4DC\uB97C \uAC78\uC5B4\uBCF4\uC138\uC694!! \uADF8\uB9AC\uACE0 \uC751\uC6D0\uD574\uC8FC\uC138\uC694!"
    NextDialogue: {fileID: 0}
  - Text: "1\uB4F1\uC744 \uB9DE\uCD98 \uC0AC\uB78C\uC5D0\uAC8C\uB294 \uACE8\uB4DC\uB97C
      2\uBC30\uB85C \uB3CC\uB824\uB4DC\uB9B0\uB2E4\uAD6C\uC694! \uC640\uC6B0!!"
    NextDialogue: {fileID: 0}
  - Text: "2\uB4F1\uC744 \uB9DE\uCD98 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB3C4 \uACE8\uB4DC\uB97C
      \uB3CC\uB824\uB4DC\uB9B0\uB2E4\uAD6C\uC694! \uC138\uC0C1\uC5D0!!"
    NextDialogue: {fileID: 0}
  - Text: "3\uB4F1\uC740 \uC720\uAC10\uC2A4\uB7FD\uAC8C\uB3C4~ \uACE8\uB4DC\uB97C
      \uB3CC\uB824 \uBC1B\uC9C0 \uBABB\uD55C\uB2F5\uB2C8\uB2E4! \uC5D0\uAD81..."
    NextDialogue: {fileID: 0}
  - Text: "\uD558\uC9C0\uB9CC \uD589\uC6B4\uC758 \uC5EC\uC2E0\uC740 \uB298 \uB2F9\uC2E0\uD3B8\uC774\uC5D0\uC694!
      \uC9C0\uAE08 \uB2F9\uC7A5 \uB3C4\uC804\uD574\uBCF4\uB77C\uAD6C\uC694!! \uB7ED\uD0A4~"
    NextDialogue: {fileID: 0}
