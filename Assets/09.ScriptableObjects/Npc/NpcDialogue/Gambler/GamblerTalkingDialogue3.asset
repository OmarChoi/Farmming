  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: GamblerTalkingDialogue3
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: GamblerTalkingDialogue3
  Lines:
  - Text: "\uACE1\uB8E1 \uB808\uC774\uC2F1\uC774 \uBB50\uB0D0\uACE0\uC694? \uADC0\uC5EC\uC6B4
      \uACE1\uB8E1 \uCE5C\uAD6C\uB4E4\uC758 \uB2EC\uB9AC\uAE30 \uACBD\uC8FC \uD55C
      \uBC88 \uBCF4\uACE0! \uB204\uAC00 1\uB4F1\uC744 \uD560 \uC9C0 \uB9DE\uCD94\uAE30\uB9CC
      \uD558\uBA74 \uBC30\uB2F9\uAE08\uC758 2\uBC30\uB97C \uC900\uB2E4\uAD6C\uC694!!"
    NextDialogue: {fileID: 0}
  - Text: "\uC624\uB298\uC758 \uD589\uC6B4\uC758 \uC8FC\uC778\uACF5\uC740 \uB204\uAC00
      \uB420\uAE4C\uC694? \uBB3C\uB860, \uB2F9\uC5F0\uD788 \uC81C \uB208 \uC55E\uC5D0
      \uC788\uB294 \uC0AC\uB78C\uC774\uC8E0!!"
    NextDialogue: {fileID: 0}
