  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: DoctorCuringAcceptDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: DoctorCuringAcceptDialogue
  Lines:
  - Text: "\uC544\uC8FC \uC88B\uC740 \uC120\uD0DD\uC774\uAD70\uC694, \uD658\uC790
      \uBD84. \uADF8 \uC544\uC8FC \uADC0\uC5EC\uC6B4 \uACE1\uB8E1 \uCE5C\uAD6C\uB4E4\uB3C4
      \uCE58\uB8CC\uD574\uB4DC\uB9AC\uC8E0. \uD06C\uD750\uD750."
    NextDialogue: {fileID: 0}
  - Text: "\uC774\uBC88 \uCE58\uB8CC\uBE44\uB294 \uC5B4\uB514\uBCF4\uC790... \uC6D0\uB798\uB294
      \uAC80\uC0AC\uBE44\uC5D0 \uCE58\uB8CC\uBE44\uAE4C\uC9C0 \uD569\uCCD0\uC11C
      100\uB9CC \uACE8\uB4DC\uC9C0\uB9CC, \uC9C0\uC778 \uD560\uC778 98%\uC5D0 \uD2B9\uBCC4
      \uC11C\uBE44\uC2A4 2%\uB97C \uB354\uD574\uC11C \uBB34\uB8CC\uB85C \uD574\uC8FC\uC9C0."
    NextDialogue: {fileID: 0}
  - Text: "\uC9C4\uB8CC\uB294 \uD558\uB8E8\uC5D0 \uD55C \uBC88\uB9CC \uBD10\uC8FC\uB2C8,
      \uB0B4\uC77C \uB610 \uC624\uC138\uC694, \uD658\uC790 \uBD84. \uD06C\uD750\uD750."
    NextDialogue: {fileID: 0}
