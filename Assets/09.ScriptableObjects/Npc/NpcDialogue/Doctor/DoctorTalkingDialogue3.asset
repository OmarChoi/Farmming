  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: DoctorTalkingDialogue3
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: DoctorTalkingDialogue3
  Lines:
  - Text: "\uBCD1\uC5D0 \uAC78\uB838\uC744 \uB54C, \uCC98\uBC29\uD574\uC900 \uC57D\uC744
      \uBA39\uC5B4\uC57C \uC81C\uB300\uB85C \uB0AB\uB294 \uAC70 \uBAA8\uB974\uB0D0?"
    NextDialogue: {fileID: 0}
  - Text: "\uC758\uC0AC\uB4E4\uC774 \uC57D\uC744 \uCC98\uBC29\uD574\uC8FC\uB294 \uB370\uC5D0\uB294
      \uACFC\uD559\uC801\uC778 \uC774\uC720\uAC00 \uC788\uB2E4\uACE0. \uACF1\uAC8C
      \uB9D0\uC744 \uB4E4\uC73C\uBA74 \uAE08\uBC29 \uB0AB\uB294\uB2E8 \uB9D0\uC774\uC57C."
    NextDialogue: {fileID: 0}
  - Text: "\uBB50... \uB0B4 \uC785\uC7A5\uC5D0\uC120 \uD658\uC790\uAC00 \uB9CE\uC740
      \uAC8C \uC88B\uC9C0\uB9CC \uB9D0\uC774\uC57C."
    NextDialogue: {fileID: 0}
