  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Villager4TalkingDialogue3
  Lines:
  - Text: "\uD070 \uCC28\uC774\uB294 \uC5C6\uC9C0\uB9CC, \uC6B0\uC720\uC5D0 \uD64D\uCC28\uB97C
      \uD0C0\uB294 \uAC83\uC774 \uD64D\uCC28\uC5D0 \uC6B0\uC720\uB97C \uD0C0\uB294
      \uAC83\uBCF4\uB2E4 \uC870\uAE08 \uB354 \uBAB8\uC5D0 \uC88B\uB2E4\uACE0 \uD558\uB354\uAD70\uC694."
    NextDialogue: {fileID: 0}
  - Text: "\uC5B8\uC81C \uD64D\uCC28\uB97C \uB4DC\uC2DC\uAC8C \uB418\uBA74, \uD55C
      \uBC88\uCBE4 \uC2DC\uB3C4\uD574 \uBCF4\uC138\uC694."
    NextDialogue: {fileID: 0}
