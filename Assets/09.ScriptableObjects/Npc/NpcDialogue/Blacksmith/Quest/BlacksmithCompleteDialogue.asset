  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: BlacksmithCompleteDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: BlacksmithCompleteDialogue
  Lines:
  - Text: "\uACE1\uB8E1\uC740 \uC2E0\uBE44\uB85C\uC6B4 \uD798\uC744 \uC9C0\uB2C8\uACE0
      \uC788\uC5B4\uC11C, \uC790\uC5F0\uC758 \uAE30\uC6B4\uACFC \uC5F4\uC744 \uBC1B\uC73C\uBA74
      \uB354\uC6B1 \uAC15\uD574\uC9C0\uB294 \uD2B9\uC131\uC774 \uC788\uB2E4\uB124."
    NextDialogue: {fileID: 0}
  - Text: "\uC7AC\uB8CC\uC640 \uB3C8\uC744 \uAC00\uC838\uC624\uBA74, \uB0B4\uAC00
      \uACE1\uB8E1\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC \uC2DC\uCF1C\uC8FC\uACA0\uB124."
    NextDialogue: {fileID: 0}
  - Text: "... \uBD84\uBA85\uD788 \uACE1\uB8E1\uB4E4\uB3C4 \uBCF4\uB2F5\uC744 \uD574\uC904\uAC70\uB124."
    NextDialogue: {fileID: 0}
