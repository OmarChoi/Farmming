  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial6AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial6AcceptResultDialogue
  Lines:
  - Text: "\uC774\uC81C \uC6B0\uB9AC\uB4E4\uC740 \uAC00\uBD10\uC57C \uD574\uC560.
      \uB108\uCC98\uB7FC \uC774\uACF3\uC5D0 \uB3C4\uCC29\uD558\uB294 \uB2E4\uB978
      \uC0AC\uB78C\uB4E4\uC744 \uB3C4\uC640\uC918\uC57C \uD558\uAC70\uB4DC\uC740."
    NextDialogue: {fileID: 0}
  - Text: "\uB108\uC640 \uD5E4\uC5B4\uC9C0\uB294 \uAC74 \uB108~\uBB34 \uC544\uC26C\uC6CC\uC5B4~
      \uADF8\uB798\uB3C4 \uC6B0\uB9AC \uACE1\uB8E1\uB4E4\uACFC \uD568\uAED8\uB77C\uBA70\uC5B8,
      \uC5EC\uAE30\uC11C \uC798 \uC0B4\uC544\uAC08 \uC218 \uC788\uC744 \uAC70\uC57C\uC544."
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uAC00\uC544 \uC120\uBB3C\uC744 \uC900\uBE44\uD588\uC368\uC5B4~
      \uC870\uAE08 \uC788\uB2E4\uAC00 \uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5B4\uC904\uB798\uC560?"
    NextDialogue: {fileID: 0}
