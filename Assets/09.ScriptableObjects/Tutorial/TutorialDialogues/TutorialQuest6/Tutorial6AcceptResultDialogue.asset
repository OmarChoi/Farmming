  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial6AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial6AcceptResultDialogue
  Lines:
  - Text: "\uC2DD\uBB3C\uB4E4\uC740 \uB9E4\uC77C\uB9E4\uC77C \uBB3C\uC744 \uC918\uC57C
      \uD574\uC560~ \uAFB8\uC900\uD788 \uBB3C\uC744 \uC8FC\uBA70\uC5B8, \uD574\uC640
      \uB2EC\uC744 \uC5EC\uB7EC \uBC88 \uBCF4\uB2E4\uBCF4\uBA74 \uB2E4 \uC790\uB77C
      \uC788\uC744 \uAC70\uC57C\uC544!"
    NextDialogue: {fileID: 0}
  - Text: "\uC774\uC81C \uC2DD\uBB3C\uC774 \uB2E4 \uC790\uB77C\uBA70\uC5B8, \uC6B0\uB9AC
      \uBE68\uAC04 \uACE1\uB8E1 \uCE5C\uAD6C\uAC00 \uB098\uC124 \uCC28\uB840\uC57C\uC544!"
    NextDialogue: {fileID: 0}
  - Text: "\uBE68\uAC04 \uACE1\uB8E1 \uCE5C\uAD6C\uB294 \uBC14\uB78C\uC758 \uD798\uC73C\uB85C
      \uC2DD\uBB3C\uC774 \uB2E4\uCE58\uC9C0 \uC54A\uAC8C \uC218\uD655\uD560 \uC218
      \uC788\uC5B4\uC5B4!"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8 \uCE5C\uAD6C\uC640 \uD568\uAED8 \uD638\uBC15\uC744 3\uAC1C \uC218\uD655\uD574
      \uBD10\uC544~ \uB9DB\uC788\uC5B4\uBCF4\uC778\uB2E4\uAD6C \uBA39\uC73C\uBA74
      \uC548 \uB3FC\uC560~"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uB4E4\uC5D0\uAC8C \uD638\uBC15 3\uAC1C\uB97C \uAC00\uC838\uC624\uBA70\uC5B8
      \uC6B0\uB9AC\uAC00 \uBA4B\uC9C4 \uAC78 \uC904\uAC8C\uC5D0. \uC54C\uC558\uC9C0\uC774?
      \uADF8\uB7EC\uB2C8\uAE4C \uC808\uB300\uB8E8 \uBA39\uC73C\uBA74 \uC548 \uB3FC\uC560!"
    NextDialogue: {fileID: 0}
