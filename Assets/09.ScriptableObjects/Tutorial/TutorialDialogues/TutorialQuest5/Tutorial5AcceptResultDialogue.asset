  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial5AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial5AcceptResultDialogue
  Lines:
  - Text: "\uC774\uC81C \uC528\uC557\uC5D0\uAC8C \uC798 \uC790\uB77C\uB77C\uACE0
      \uBB3C\uC744 \uC8FC\uC790\uC544~ \uC6B0\uB9AC \uD30C\uB780 \uACE1\uB8E1 \uCE5C\uAD6C\uAC00\uC544
      \uBB3C\uC744 \uBFDC\uC5B4\uC11C \uC528\uC557\uC5D0\uAC8C \uBB3C\uC744 \uC904
      \uC218 \uC788\uC5B4\uC5B4~"
    NextDialogue: {fileID: 0}
  - Text: "\uD30C\uB780 \uACE1\uB8E1\uC744 \uB4E0 \uCC44\uB85C, \uC528\uC557\uC774
      \uC2EC\uC5B4\uC9C4 \uACF3\uC5D0 \uC88C\uD074\uB9AD\uC744 \uD558\uBA74 \uBB3C\uC744
      \uC904 \uC218 \uC788\uC5B4\uC5B4~"
    NextDialogue: {fileID: 0}
  - Text: "\uC774 \uCE5C\uAD6C\uAC00 \uBFCC\uB9AC\uB294 \uBB3C\uC5D0\uB294 \uC601\uC591\uAC00\uAC00
      \uB9CE\uC544\uC11C\uC5B4~ \uC791\uBB3C\uC774 \uC798 \uC790\uB77C\uB3C4\uB85D
      \uB3C4\uC640\uC904 \uAC70\uC57C\uC544~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB7EC\uBA74 \uD30C\uB780 \uACE1\uB8E1 \uCE5C\uAD6C\uC640 \uD568\uAED8\uC5D0
      \uC2DD\uBB3C\uC5D0 \uBB3C\uC744 \uC8FC\uACE0 \uC640\uBD10\uC544!"
    NextDialogue: {fileID: 0}
