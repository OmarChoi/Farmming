  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial3AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial3AcceptResultDialogue
  Lines:
  - Text: "\uC774\uC81C\uC5D0 \uC528\uC557\uC744 \uAD6C\uD574\uBCF4\uC790\uC544~
      \uADF8\uB7EC\uACE0\uBCF4\uB2C8\uC774, \uC5BC\uB9C8 \uC804\uC5D0 \uB108\uC640
      \uBE44\uC2B7\uD558\uAC8C \uC0DD\uAE34 \uC0AC\uB78C\uC774\uC774 \uBB3C\uAC74\uC744
      \uC794\uB729 \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC78 \uBC1C\uACAC\uD588\uC5C8\uC5B4\uC5B4."
    NextDialogue: {fileID: 0}
  - Text: "'\uC7AC\uB8CC\uB9CC \uC788\uB2E4\uBA74 B\uB97C \uB20C\uB7EC \uC0C1\uC810\uC744
      \uC138\uC6B8 \uC218 \uC788\uC5C8\uC744 \uD150\uB370. \uC544\uC774\uACE0 \uC774\uB97C
      \uC5B4\uC9F8.' \uB77C\uACE0 \uD55C\uC228\uC744 \uC26C\uACE0 \uC788\uC5C8\uC5B4\uC5B4.
      \uADF8 \uC0AC\uB78C\uC774 \uC528\uC557\uB3C4 \uAC00\uC9C0\uACE0 \uC788\uC744
      \uAC70\uC57C\uC544!"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uAC00\uC544 \uBAA8\uC740 \uB098\uBB34\uC640 \uB3CC\uB85C
      \uAC74\uBB3C\uC744 \uC9C0\uC5B4 \uBCF4\uC790\uC544. \uADF8\uB7EC\uBA70\uC5B8
      \uADF8 \uC0AC\uB78C\uB450 \uC6B0\uB9B4 \uB3C4\uC640\uC904 \uAC70\uC57C\uC544."
    NextDialogue: {fileID: 0}
  - Text: "\uB9DE\uB2E4\uC544~ \uADF8 \uC0AC\uB78C\uC774\uC774 \uBB3C\uAC74\uC744
      \uAC70\uB798\uD558\uB824\uBA74, \uC774 '\uACE8\uB4DC'\uB77C\uB294 \uBC18\uC9DD\uC774\uAC00
      \uD544\uC694\uD558\uB314\uC5B4\uC5B4. \uC6B0\uB9AC\uAC00 \uBAA8\uC544\uB454
      \uAC8C \uC788\uC73C\uB2C8\uAE4C\uC544, \uC6B0\uC815\uC758 \uC99D\uD45C\uB85C
      \uB108\uC5D0\uAC8C \uC904\uAC8C\uC5D0!"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB7EC\uBA70\uC5B8 \uC0C1\uC810\uC744 \uC9D3\uACE0, \uADF8 \uC0AC\uB78C\uC5D0\uAC8C\uC11C
      \uC528\uC557\uC744 \uAD6C\uD574\uBCF4\uC790\uC544! \uD638\uBC15\uC528 3\uAC1C\uBA74
      \uB531 \uC88B\uC744 \uAC70 \uAC19\uC544\uC544~"
    NextDialogue: {fileID: 0}
