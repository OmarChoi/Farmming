  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial3AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial3AcceptResultDialogue
  Lines:
  - Text: "\uC774\uC81C\uC5D0 \uC528\uC557\uC744 \uAD6C\uD574\uBCF4\uC790\uC544~
      \uC528\uC557\uC740 \uC5B4\uB5A4 \uCC29\uD55C \uC0AC\uB78C\uC774 \uAC00\uC9C0\uACE0
      \uC788\uC368\uC5B4~ \uC0AC\uB78C\uB4E4\uC740 \uC0C1\uC778\uC774\uB77C\uAD6C
      \uBD80\uB974\uB354\uB77C\uACE0\uC624?"
    NextDialogue: {fileID: 0}
  - Text: "B\uD0A4\uB97C \uB204\uB974\uBA70\uC5B8 \uAC74\uBB3C\uC744 \uC9C0\uC744
      \uC218 \uC788\uACE0\uC624, \uAC74\uBB3C\uC774 \uC0DD\uAE30\uBA74 \uC0AC\uB78C\uC774
      \uB180\uB7EC\uC628\uB314\uC5B4\uC5B4! \uB108\uB97C \uB3C4\uC640\uC904 \uC0AC\uB78C\uC774
      \uC788\uB2E4\uBA74, \uADF8 \uC0AC\uB78C\uC774 \uC774\uBBF8 \uC0C1\uC810\uC744
      \uC9C0\uC5B4\uB1A8\uC744 \uC9C0\uB3C4 \uBAB0\uB77C\uC544~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB7F0\uB370\uC5D0 \uC0AC\uB78C\uB4E4\uC740 \uC774 \uBC18\uC9DD\uC774\uB97C
      \uBB3C\uAC74\uC774\uB791 \uAD50\uD658\uD558\uB354\uB77C\uAD6C\uC6B0~ \uB108\uC5D0\uAC8C
      \uC880 \uC904 \uD14C\uB2C8\uAE4C, \uD638\uBC15\uC528\uB97C 3\uAC1C \uAC00\uC838\uC62C\uB798\uC560?"
    NextDialogue: {fileID: 0}
  - Text: "\uC0C1\uC778 \uC544\uC800\uC528\uC5D0\uAC8C\uC11C\uC5B4 \uD638\uBC15\uC528
      3\uAC1C\uB97C \uAD6C\uD574\uC640 \uC918\uC5B4~"
    NextDialogue: {fileID: 0}
