  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial7CompleteDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial7CompleteDialogue
  Lines:
  - Text: "\uC790\uC544~ \uC6B0\uB9AC\uAC00 \uBAA8\uC544\uB454 \uBC18\uC9DD\uC774
      2\uCC9C\uAC1C\uC57C\uC544! \uB108\uB77C\uBA70\uC5B8 \uC6B0\uB9AC\uB4E4\uBCF4\uB2E4
      \uC720\uC6A9\uD558\uAC8C \uC4F8 \uC218 \uC788\uC744 \uAC70\uC57C\uC544~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB9AC\uACE0 \uC774 \uBB3C\uC57D\uB3C4 \uC904\uAC8C\uC5D0~ \uB178\uB791
      \uACE1\uB8E1 \uCE5C\uAD6C\uAC00 \uC774\uAC78 \uBA39\uC5C8\uB354\uB2C8\uC774,
      \uD798\uC774 \uB9C8\uAD6C\uB9C8\uAD6C \uC384\uC838\uC11C \uB098\uBB34\uC640
      \uB3CC\uC744 \uB9CE\uC774 \uBD80\uC218\uB354\uB77C\uACE0\uC624! \uB300\uB2E8\uD574\uC560!"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uAC00 \uC544\uB07C\uB358 \uAC70\uC9C0\uB9C8\uC548~ \uB108\uB294
      \uD2B9\uBCC4\uD55C \uC0AC\uB78C\uC774\uB2C8\uAE4C\uC544 \uC8FC\uACE0 \uC2F6\uC5C8\uC5B4\uC5B4~
      \uC6B0\uB9AC\uB3C4 \uBA4B\uC9C4 \uACE1\uB8E1\uB4E4\uC774\uC9C0\uC774??"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB7EC\uBA74 \uC774\uC81C\uBD80\uD130\uC5B4~ \uC6B0\uB9AC\uB4E4\uC758
      \uD589\uC131\uC5D0\uC11C \uBA4B\uC9C4 \uC0B6\uC744 \uC0AC\uB294 \uAC70\uC57C\uC544!
      \uC6B0\uB9AC\uAC00 \uC5B8\uC81C\uB098 \uC751\uC6D0\uD558\uACE0 \uC788\uC744\uAC8C\uC5D0~
      \uC54C\uC558\uC9C0\uC774?"
    NextDialogue: {fileID: 0}
  - Text: "\uC78A\uC9C0 \uB9D0\uC544\uC918\uC5B4. \uB108\uB294 \uC6B0\uB9AC\uB4E4\uC5D0\uAC8C
      \uC815\uB9D0 \uD2B9\uBCC4\uD55C \uC0AC\uB78C\uC774\uC57C\uC544!"
    NextDialogue: {fileID: 0}
