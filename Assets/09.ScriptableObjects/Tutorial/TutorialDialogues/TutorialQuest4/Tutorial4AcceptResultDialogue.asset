--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial4AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial4AcceptResultDialogue
  Lines:
  - Text: "\uC774\uC81C \uD638\uBC15\uC744 \uAE38\uB7EC\uBCF4\uC790\uC544~ \uC6B0\uB9AC\uAC00
      \uC528\uC557\uC5D0 \uB9C8\uBC95\uC744 \uAC78\uC5B4\uC918\uC11C \uBE60\uB974\uAC8C
      \uC790\uB784 \uAC70\uC57C\uC544~ \uACE1\uB8E1\uB4E4\uC758 \uD798\uC744 \uBE4C\uB9AC\uBA74
      \uD638\uBC15\uB3C4 \uAE08\uBC29 \uC790\uB77C\uAC8C \uD560 \uC218 \uC788\uC368\uC5B4!"
    NextDialogue: {fileID: 0}
  - Text: "\uBA3C\uC800 \uCD08\uB85D\uC0C9\uC774 \uBA4B\uC9C0\uC778 \uACBD\uC791/\uD30C\uC885
      \uACE1\uB8E1\uC774 \uB3C4\uC640\uC904 \uAC70\uC57C\uC544~ \uC5B4\uB5A4 \uACE1\uB8E1\uC744
      \uC190\uC5D0 \uB4E4 \uC9C0\uB294 1\uBC88\uD0A4\uC640 3\uBC88\uD0A4\uB85C \uBC14\uAFC0
      \uC218 \uC788\uC5B4\uC5B4."
    NextDialogue: {fileID: 0}
  - Text: "\uCD08\uB85D \uACE1\uB8E1 \uCE5C\uAD6C\uB97C \uB4E4\uACE0, \uC6D0\uD558\uB294
      \uB545\uC5D0 \uB300\uACE0 \uC88C\uD074\uB9AD\uC744 \uB20C\uB7EC\uC11C \uB545\uC744
      \uAC08\uC544\uC544~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8 \uC0C1\uD0DC\uC5D0\uC11C I\uD0A4\uB97C \uB20C\uB7EC\uC11C \uAC00\uBC29\uC744
      \uC5F4\uACE0\uC624, \uC2EC\uACE0 \uC2F6\uC740 \uC528\uC557\uC744 \uC6B0\uD074\uB9AD\uD558\uBA74
      \uACE1\uB8E1 \uCE5C\uAD6C\uAC00 \uBA38\uAE08\uAC8C \uD560 \uC218 \uC788\uC5B4\uC5B4~"
    NextDialogue: {fileID: 0}
  - Text: "\uCD08\uB85D \uACE1\uB8E1 \uCE5C\uAD6C\uAC00 \uC528\uC557\uC744 \uBA39\uC5B4\uC57C
      \uD558\uB2C8\uAE4C, \uBC16\uC5D0 \uB098\uC640 \uC788\uB294 \uC0C1\uD0DC\uC5D0\uC11C
      \uBA39\uC5EC\uC918\uC57C \uD574\uC560~ \uC54C\uC558\uC9C0\uC774?"
    NextDialogue: {fileID: 0}
  - Text: "\uACE1\uB8E1\uC774 \uC528\uC557\uC744 \uBA38\uAE08\uC5C8\uC73C\uBA74,
      \uC798 \uAC08\uB9B0 \uB545\uC5D0 \uBFCC\uB9AC\uAE30\uB9CC \uD558\uBA74 \uB3FC\uC560~
      \uC528\uC557\uC744 \uC2EC\uACE0 \uC2F6\uC740 \uACF3\uC5D0 \uC6B0\uD074\uB9AD\uC744
      \uD558\uBA74 \uC528\uB97C \uC2EC\uC744 \uC218 \uC788\uC5B4\uC5B4~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB7EC\uBA74 \uD638\uBC15\uC528 3\uAC1C\uB97C \uB545\uC5D0 \uC2EC\uACE0
      \uC6B0\uB9AC\uB4E4\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uC5B4\uC904\uB798\uC560?
      \uCC28\uADFC\uCC28\uADFC \uD558\uB098\uC529 \uD574\uBCF4\uC790\uC544~"
    NextDialogue: {fileID: 0}
