  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial1AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial1AcceptResultDialogue
  Lines:
  - Text: "\uC548\uB140\uC5C9~ \uC6B0\uB9AC \uD589\uC131\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574\uC560!"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uB4E4\uC740 \uACE1\uB8E1\uC774\uC57C\uC544~ \uB108\uC640
      \uBE44\uC2B7\uD558\uAC8C \uC0DD\uAE34 \uC0AC\uB78C\uC774 \uBD99\uC5EC\uC8FC\uC5C8\uC5B4\uC5B4~"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uB4E4\uC740 \uB9CE\uC740 \uC77C\uC744 \uD560 \uC218 \uC788\uC368\uC5B4!
      \uB545\uB3C4 \uAC08\uACE0, \uBB3C\uB3C4 \uBFDC\uACE0, \uC2DD\uBB3C\uC744 \uC790\uB77C\uAC8C
      \uD560 \uC218\uB3C4 \uC788\uC5B4\uC5B4. \uAC15\uD55C \uD798\uC73C\uB85C \uB098\uBB34\uC640
      \uB3CC\uB3C4 \uBD80\uC220 \uC218 \uC788\uB2E4\uACE0\uC624~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB7F0\uB370\uC5D0 \uC6B0\uB9AC\uB4E4\uC740 \uD0A4\uAC00 \uC791\uC544\uC11C\uC5B4
      \uBA3C \uACF3\uAE4C\uC9C0 \uB2A5\uB825\uC744 \uBC1C\uC0AC\uD558\uAE30 \uD798\uB4E4\uC5B4\uC5B4.
      \uB124\uAC00 \uB3C4\uC640\uC904\uB798\uC560?"
    NextDialogue: {fileID: 0}
  - Text: "E\uD0A4\uB97C \uB20C\uB7EC\uC11C\uC5B4 \uACE1\uB8E1\uC744 \uAEBC\uB0B4\uACE0\uC624,
      F\uD0A4\uB97C \uB204\uB974\uBA74 \uC6B0\uB9AC\uB97C \uB4E4 \uC218 \uC788\uC5B4\uC5B4!"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uB4E4\uC744 \uC190\uC5D0 \uB4E0 \uCC44\uB85C \uC88C\uD074\uB9AD\uACFC
      \uC6B0\uD074\uB9AD\uC744 \uB204\uB974\uBA70\uC5B8, \uC6B0\uB9AC\uB4E4\uC758
      \uBA4B\uCC10 \uB2A5\uB825\uC744 \uBCFC \uC218 \uC788\uC5B4\uC5B4! \uC800\uB9C8\uB2E4
      \uB2E4\uC591\uD55C \uB2A5\uB825\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4\uAD6C\uC6B0~"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uC11C\uC5B8 \uB098\uBB34\uC640 \uB3CC\uC744 \uBAA8\uC544\uC11C
      \uC6B0\uB9AC\uB4E4\uC758 \uD798\uC744 \uBCFC\uB798\uC560? \uB098\uBB34\uC640
      \uB3CC\uC744 \uC798 \uCE90\uB294 \uCE5C\uAD6C\uAC00 \uC788\uC5B4\uC5B4~ \uB178\uB791\uC0C9\uC5D0
      \uC810\uBC15\uC774 \uBB34\uB2AC\uAC00 \uC788\uB294 \uCE5C\uAD6C\uC57C\uC544~
      \uC0AC\uB78C\uB4E4\uC740 \uBC8C\uBAA9 \uCC44\uAD74 \uACE1\uB8E1\uC774\uB77C\uACE0
      \uBD88\uB7EC\uC5B4. \uADF8 \uCE5C\uAD6C\uC640 \uD568\uAED8 \uB098\uBB34\uC640
      \uB3CC\uC744 2\uAC1C\uC529 \uBAA8\uC544\uBD10\uC544~"
    NextDialogue: {fileID: 0}
