  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial1AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial1AcceptResultDialogue
  Lines:
  - Text: "\uC6B0\uC640\uC544~ \uBABB\uBCF4\uB358 \uC0AC\uB78C\uC774\uB2E4\uC544~
      \uD658\uC601\uD574\uC560~"
    NextDialogue: {fileID: 0}
  - Text: "\uC73C\uC751? \uB204\uAC00 \uBD80\uB974\uB294 \uAC70\uB0D0\uACE0\uC624?
      \uC6B0\uB9AC\uAC00 \uBA40\uC5B4\uC11C \uC798 \uC548 \uBCF4\uC774\uB098 \uBD10\uC544~"
    NextDialogue: {fileID: 0}
  - Text: "\uC6B0\uB9AC\uB4E4\uC740 \uB124 \uADFC\uCC98\uC5D0 \uC788\uC5B4\uC5B4!
      WASD\uD0A4\uB97C \uC774\uC6A9\uD574\uC11C \uC6C0\uC9C1\uC5EC\uBD10\uC544~ Shift\uB97C
      \uB20C\uB7EC \uB2EC\uB9B4 \uC218\uB3C4 \uC788\uB2E4\uAD6C\uC6B0~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB9AC\uACE0\uC624 \uC5B8\uB355\uC774 \uC788\uC73C\uBA74 Space\uBC14\uB97C
      \uB20C\uB7EC\uC11C \uC810\uD504\uD558\uBA74 \uB3FC\uC560~"
    NextDialogue: {fileID: 0}
  - Text: "\uC9C0\uAE08 \uBAB8\uC744 \uC6C0\uC9C1\uC5EC\uC11C\uC5B4 \uC6B0\uB9AC\uB4E4\uC744
      \uD55C \uBC88 \uCC3E\uC544\uBD10\uC544~ \uAE08\uBC29 \uCC3E\uC744 \uC218 \uC788\uC744
      \uAC70\uC57C\uC544~"
    NextDialogue: {fileID: 0}
