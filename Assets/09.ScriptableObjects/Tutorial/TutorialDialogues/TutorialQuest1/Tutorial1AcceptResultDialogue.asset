  m_Script: {fileID: 11500000, guid: 0a9fc87e559961a47b33e7a3c95bc051, type: 3}
  m_Name: Tutorial1AcceptResultDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueSO
  Id: Tutorial1AcceptResultDialogue
  Lines:
  - Text: "\uC6B0\uC640\uC544~ \uC774\uC0C1\uD55C \uC0DD\uBA85\uCCB4\uAC00 \uB098\uD0C0\uB0AC\uB2E4\uC544~
      \uBAA8\uB450 \uC228\uC5B4\uC5B4~!"
    NextDialogue: {fileID: 0}
  - Text: "\uC800 \uC0DD\uBA85\uCCB4\uB290\uC740 WASD\uD0A4\uB97C \uC774\uC6A9\uD574\uC11C
      \uC6C0\uC9C1\uC774\uACE0\uC624, Shift\uB97C \uB20C\uB7EC \uB2EC\uB9B4 \uC218\uB3C4
      \uC788\uB2E4\uB294 \uAC78 \uBAA8\uB97C \uAC70\uC57C\uC544~"
    NextDialogue: {fileID: 0}
  - Text: "\uADF8\uB9AC\uACE0\uC624 \uC5B8\uB355\uC774 \uC788\uC73C\uBA74 Space\uBC14\uB97C
      \uB20C\uB7EC\uC11C \uC810\uD504\uD574\uC57C \uB418\uB294 \uC0AC\uC2E4\uB450
      \uBAA8\uB97C \uAC70\uC57C\uC544!"
    NextDialogue: {fileID: 0}
  - Text: "\uC5EC\uAE30 \uC788\uC73C\uBA74 \uC800\uC5B4\uC5B4\uC5BC\uB300\uB85C \uC6B0\uB9AC\uB4E4\uC744
      \uBABB \uCC3E\uACA0\uC9C0\uC774?"
    NextDialogue: {fileID: 0}
  - Text: "(\uC544\uBB34\uB798\uB3C4 \uACBD\uACC4\uB97C \uD558\uB294 \uAC83\uCC98\uB7FC
      \uBCF4\uC778\uB2E4. \uBAB8\uC744 \uC6C0\uC9C1\uC5EC\uC11C \uC774\uACF3 \uC0DD\uBA85\uCCB4\uB4E4\uC744
      \uCC3E\uC544\uBCF4\uC790.)"
    NextDialogue: {fileID: 0}
